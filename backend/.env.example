# LearnHub 后端环境变量模板
# 用法：复制为 backend/.env 后按需修改（.env 已在 .gitignore 中，不会被提交）
#   cp .env.example .env

# ---------- 必填：MySQL 连接串 ----------
LEARNHUB_DB_URL=mysql://root:你的密码@127.0.0.1:3306/learnhub

# ---------- 测试专用库（可选，但推荐）----------
# 必须与上面的业务库分开：测试会 DROP 掉这个库再重建。
# 库名必须以 _test 结尾，否则测试会拒绝运行（防止误删生产库）。
LEARNHUB_TEST_DB_URL=mysql://root:你的密码@127.0.0.1:3306/learnhub_test

# ---------- 必填（上线前）：会话签名 + API Key 加密主密钥 ----------
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 不换的后果：任何人都能伪造管理员令牌，并解密库里已保存的所有用户 API Key。
# 注意：改了之后，用户之前存进库里的 API Key 会解不开（需重新填）。
LEARNHUB_SECRET=dev-only-change-me-in-production

# ---------- 监听地址 ----------
PORT=8899
HOST=127.0.0.1

# ---------- 跨源（前后端分离后前端在别的端口）----------
# '*' 放行任意来源（默认，方便本地）；也可写逗号分隔白名单，例如：
# LEARNHUB_CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
LEARNHUB_CORS_ORIGIN=*

# ---------- 可选项 ----------
LEARNHUB_DEFAULT_PROVIDER=deepseek
LEARNHUB_DAILY_AI_LIMIT=3
LEARNHUB_PLATFORM_API_KEY=
LEARNHUB_TOKEN_TTL=604800

# 启动时是否幂等建表 / 空库自动灌演示数据（1 开，0 关）
LEARNHUB_AUTO_MIGRATE=1
LEARNHUB_SEED=1
